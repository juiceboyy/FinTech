# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Zenmoney Remote MCP & OAuth Settings
# Remote MCP Endpoint
ZENMONEY_MCP_URL=https://api.zenmoney.app/mcp

# Option 1: Direct personal access token
ZENMONEY_TOKEN=

# Option 2: OAuth 2.0 PKCE Client Credentials (Optional, if registering a client)
ZENMONEY_CLIENT_ID=
ZENMONEY_CLIENT_SECRET=
ZENMONEY_REDIRECT_URI=http://localhost:3000/oauth/callback
